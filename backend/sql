CREATE TABLE document_updates (

    id BIGSERIAL PRIMARY KEY,

    document_id UUID NOT NULL,

    update BYTEA NOT NULL,

    created_at TIMESTAMP DEFAULT NOW(),

    FOREIGN KEY(document_id)
        REFERENCES documents(id)
